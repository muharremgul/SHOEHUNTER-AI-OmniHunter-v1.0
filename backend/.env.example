MONGO_URL=mongodb://localhost:27017
DB_NAME=shoehunter_ai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication is required by default. If ADMIN_PASSWORD is empty, the
# first-run screen asks you to create the administrator password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_HOURS=24
COOKIE_SECURE=false
SETUP_TOKEN=
APP_SECRET_KEY=
SECRET_KEY_FILE=./.shoehunter.key

# Run the built-in scheduler for a simple local install. Docker uses the
# separate durable scheduler and worker services instead.
EMBEDDED_SCHEDULER=true
# Only used when worker.py runs as a separate process: default or browser.
WORKER_QUEUE=default

# Optional URL-discovery source. It finds candidate links only; product pages
# remain the source of truth for price and stock.
BRAVE_SEARCH_API_KEY=

# Durable backups and privacy controls.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
AI_HISTORY_RETENTION_DAYS=30
NOTIFICATION_MODE=immediate

# Firebase Cloud Messaging HTTP v1. Keep the service-account JSON outside Git.
FIREBASE_PROJECT_ID=shophunter-radar
GOOGLE_APPLICATION_CREDENTIALS=C:\\Users\\username\\ShoeHunter-Secrets\\firebase-admin.json

# Resource budgets. Store adapters may lower these values further.
GLOBAL_FETCH_CONCURRENCY=8
STORE_FETCH_CONCURRENCY=2
GLOBAL_BROWSER_CONCURRENCY=2
STORE_BROWSER_CONCURRENCY=1
MAX_RESPONSE_BYTES=5242880
CRAWLER_USER_AGENT=ShoeHunterAI/0.6 (+local product monitor; contact the operator)

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Full public callback URL, for example https://shoehunter.example.com/telegram/callback
TELEGRAM_WEBHOOK_URL=
# Random 16-256 character value also sent to Telegram during setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Optional: enables AI Coach and AI query normalization.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMERGENT_LLM_KEY=
